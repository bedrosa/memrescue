<Window x:Class="MemRescue.FillPatternsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patrones de relleno" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="12"
        AutomationProperties.AutomationId="FillPatternsDialog"
        FocusManager.FocusedElement="{Binding ElementName=BadFillBox}">
    <StackPanel Margin="14" MaxWidth="460">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Cuando un sector no se puede leer (ilegible) o no se lee por un salto sobre una zona dañada (saltado), MemRescue lo rellena con un patrón de 4 bytes repetido. Ese relleno NUNCA son datos del origen: cada sector indica siempre su estado y el visor lo marca como NO FIABLE." />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="BadFillLabel" Text="Sectores _ilegibles:" VerticalAlignment="Center" Margin="0,2,8,2" />
            <TextBox x:Name="BadFillBox" Grid.Column="1" FontFamily="Consolas" Padding="2" Margin="0,2"
                     AutomationProperties.AutomationId="BadFillBox"
                     AutomationProperties.LabeledBy="{Binding ElementName=BadFillLabel}"
                     TextChanged="Pattern_TextChanged" />
            <TextBlock x:Name="BadFillPreview" Grid.Column="2" FontFamily="Consolas" VerticalAlignment="Center" Margin="8,2,0,2"
                       Foreground="{StaticResource MutedBrush}" AutomationProperties.AutomationId="BadFillPreview" />
            <TextBlock x:Name="SkipFillLabel" Grid.Row="1" Text="Sectores _saltados:" VerticalAlignment="Center" Margin="0,2,8,2" />
            <TextBox x:Name="SkipFillBox" Grid.Row="1" Grid.Column="1" FontFamily="Consolas" Padding="2" Margin="0,2"
                     AutomationProperties.AutomationId="SkipFillBox"
                     AutomationProperties.LabeledBy="{Binding ElementName=SkipFillLabel}"
                     TextChanged="Pattern_TextChanged" />
            <TextBlock x:Name="SkipFillPreview" Grid.Row="1" Grid.Column="2" FontFamily="Consolas" VerticalAlignment="Center" Margin="8,2,0,2"
                       Foreground="{StaticResource MutedBrush}" AutomationProperties.AutomationId="SkipFillPreview" />
        </Grid>
        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"
                   Text="Escriba 4 caracteres ASCII (p. ej. BAD!) u 8 dígitos hexadecimales (p. ej. DEADBEEF). No se admiten patrones con los cuatro bytes iguales (00000000 se confundiría con sectores dispersos o datos a cero) ni el mismo patrón para ambos estados. Por defecto: BAD! y SKIP." />
        <TextBlock x:Name="ErrorText" Margin="0,6,0,0" Foreground="#B3261E" FontWeight="SemiBold" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="FillPatternsError" AutomationProperties.LiveSetting="Assertive" />
        <DockPanel Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="ResetButton" Content="_Restablecer valores por defecto" DockPanel.Dock="Left" Click="Reset_Click"
                    AutomationProperties.AutomationId="FillPatternsResetButton" />
            <Button Content="Cancelar" IsCancel="True" MinWidth="80" DockPanel.Dock="Right" Margin="0"
                    AutomationProperties.AutomationId="FillPatternsCancelButton" />
            <Button x:Name="OkButton" Content="Guardar" IsDefault="True" MinWidth="80" DockPanel.Dock="Right" Click="Ok_Click"
                    AutomationProperties.AutomationId="FillPatternsSaveButton" />
        </DockPanel>
    </StackPanel>
</Window>
