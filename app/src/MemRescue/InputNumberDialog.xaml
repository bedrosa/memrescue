<Window x:Class="MemRescue.InputNumberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MemRescue" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="12"
        FocusManager.FocusedElement="{Binding ElementName=ValueBox}">
    <StackPanel Margin="14" MinWidth="320">
        <TextBlock x:Name="PromptText" Margin="0,0,0,6" />
        <TextBox x:Name="ValueBox" FontFamily="Consolas" Padding="3" />
        <TextBlock x:Name="HintText" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="360" />
        <TextBlock x:Name="ErrorText" Margin="0,4,0,0" Foreground="#B3261E" TextWrapping="Wrap" MaxWidth="360" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Aceptar" IsDefault="True" MinWidth="80" Click="Ok_Click" />
            <Button Content="Cancelar" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
