<Application x:Class="MemRescue.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Identidad visual de MemRescue: sobria, densa y técnica. -->
        <SolidColorBrush x:Key="BrandBrush" Color="#0F5C6E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#F28721" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F4F7F8" />
        <SolidColorBrush x:Key="BorderBrush" Color="#C9D3D7" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7B82" />

        <Style TargetType="MenuItem">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="PropName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,1,12,1" />
        </Style>
        <Style x:Key="PropValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
    </Application.Resources>
</Application>
