<Window x:Class="MemRescue.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MemRescue"
        Title="MemRescue" Height="760" Width="1180" MinHeight="460" MinWidth="780"
        Icon="Assets/MemRescue.ico"
        WindowStartupLocation="CenterScreen"
        FontSize="12">
    <Window.CommandBindings>
        <CommandBinding Command="Open" Executed="OpenImage_Executed" />
        <CommandBinding Command="Close" Executed="CloseSource_Executed" CanExecute="HasSource_CanExecute" />
        <CommandBinding Command="local:Commands.GoToSector" Executed="GoToSector_Executed" CanExecute="HasSource_CanExecute" />
        <CommandBinding Command="local:Commands.GoToOffset" Executed="GoToOffset_Executed" CanExecute="HasSource_CanExecute" />
        <CommandBinding Command="local:Commands.PrevSector" Executed="PrevSector_Executed" CanExecute="HasSource_CanExecute" />
        <CommandBinding Command="local:Commands.NextSector" Executed="NextSector_Executed" CanExecute="HasSource_CanExecute" />
        <CommandBinding Command="local:Commands.FirstSector" Executed="FirstSector_Executed" CanExecute="HasSource_CanExecute" />
        <CommandBinding Command="local:Commands.LastSector" Executed="LastSector_Executed" CanExecute="HasSource_CanExecute" />
        <CommandBinding Command="local:Commands.CopyHex" Executed="CopyHex_Executed" CanExecute="HasSource_CanExecute" />
        <CommandBinding Command="local:Commands.OpenRange" Executed="OpenRange_Executed" CanExecute="HasSource_CanExecute" />
    </Window.CommandBindings>

    <DockPanel>
        <!--
            Menús organizados como los de la herramienta de referencia (Disco / Herramientas / Ventanas /
            Editor / Modo / Edición) con textos propios. Lo que aún no existe está deshabilitado e indica
            el hito del roadmap en que se implementa; nada simula funcionar.
        -->
        <Menu DockPanel.Dock="Top" Padding="2">
            <MenuItem Header="_Disco" AutomationProperties.AutomationId="DiskMenu">
                <MenuItem Header="_Abrir imagen de disco…" Command="Open" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Cerrar origen" Command="Close" InputGestureText="Ctrl+F4" />
                <MenuItem Header="Abrir _rango de sectores como dispositivo…" AutomationProperties.AutomationId="OpenRangeMenuItem"
                          Command="local:Commands.OpenRange" InputGestureText="Ctrl+Mayús+R"
                          ToolTip="Presenta un tramo de sectores del origen seleccionado (p. ej. una partición) como un origen independiente" />
                <Separator />
                <MenuItem Header="_Seleccionar disco físico…" IsEnabled="False" InputGestureText="(M9)" ToolTip="Pendiente: acceso a discos físicos (hito M9)" />
                <MenuItem Header="Construir _RAID virtual…" IsEnabled="False" InputGestureText="(M5)" ToolTip="Pendiente: RAID virtual (hito M5)" />
                <MenuItem Header="_Particiones…" AutomationProperties.AutomationId="PartitionsMenuItem" Click="ShowPartitionsTab_Click"
                          ToolTip="Tabla de particiones del origen seleccionado (MBR/EBR) con su confianza y anomalías; cada partición se puede abrir como dispositivo" />
                <MenuItem Header="_Bloquear volúmenes…" IsEnabled="False" InputGestureText="(M9)" ToolTip="Pendiente (hito M9)" />
                <MenuItem Header="Parámetros de _E/S…" IsEnabled="False" InputGestureText="(M9)" ToolTip="Pendiente: política de errores en dispositivos reales (hito M9)" />
                <Separator />
                <MenuItem Header="Modo global de solo _lectura" IsCheckable="True" IsChecked="True" IsEnabled="False"
                          ToolTip="Siempre activo: en esta versión MemRescue no puede escribir en ningún origen" />
                <MenuItem Header="Deshacer / rehacer / aplicar cambios" IsEnabled="False" InputGestureText="(M11)" ToolTip="Pendiente: capa de cambios diferidos (hitos M11–M12)" />
                <Separator />
                <MenuItem Header="_Salir" Click="Exit_Click" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Herramientas" AutomationProperties.AutomationId="ToolsMenu">
                <MenuItem Header="Calcular _hashes del origen…" Click="ShowChecksTab_Click" />
                <MenuItem Header="Comprobar _legibilidad (leer todos los sectores)…" Click="ShowChecksTab_Click" />
                <MenuItem Header="_Patrones de relleno de sectores no fiables…" AutomationProperties.AutomationId="FillPatternsMenuItem"
                          Click="FillPatterns_Click"
                          ToolTip="Patrones de 4 bytes con que se rellenan los sectores ilegibles y saltados (nunca son datos del origen)" />
                <Separator />
                <MenuItem Header="_Escaneo completo…" IsEnabled="False" InputGestureText="(M6)" ToolTip="Pendiente (hito M6)" />
                <MenuItem Header="Todo lo encontrado / _FS virtual…" IsEnabled="False" InputGestureText="(M6)" ToolTip="Pendiente (hito M6)" />
                <MenuItem Header="Buscar en carpetas por _nombre…" IsEnabled="False" InputGestureText="(M4)" ToolTip="Pendiente (hito M4)" />
                <MenuItem Header="_Recuperar / crear lista de ficheros…" IsEnabled="False" InputGestureText="(M4)" ToolTip="Pendiente: motor de recuperación (hito M4)" />
                <MenuItem Header="Búsqueda RAW por _firmas…" IsEnabled="False" InputGestureText="(M7)" ToolTip="Pendiente (hito M7)" />
                <MenuItem Header="_Mapa de clusters" IsEnabled="False" InputGestureText="(M11)" ToolTip="Pendiente (hito M11)" />
                <MenuItem Header="_Copiar sectores (imagen/clon)…" IsEnabled="False" InputGestureText="(M9)" ToolTip="Pendiente (hito M9)" />
                <MenuItem Header="Buscar cadena / sector especial…" IsEnabled="False" InputGestureText="(M11)" ToolTip="Pendiente (hito M11)" />
                <MenuItem Header="Herramientas _NTFS" IsEnabled="False" InputGestureText="(M12)" ToolTip="Pendiente: requiere escritura segura (hito M12)" />
            </MenuItem>
            <MenuItem Header="_Ventanas">
                <MenuItem x:Name="LogMenuItem" Header="_Registro de actividad" IsCheckable="True" IsChecked="True" Click="ToggleLog_Click" />
                <MenuItem Header="Árbol de _directorios" IsEnabled="False" InputGestureText="(M10)" ToolTip="Pendiente (hito M10)" />
                <MenuItem Header="_Panel de ficheros" IsEnabled="False" InputGestureText="(M10)" ToolTip="Pendiente (hito M10)" />
                <MenuItem Header="Panel de _búsqueda" IsEnabled="False" InputGestureText="(M10)" ToolTip="Pendiente (hito M10)" />
            </MenuItem>
            <MenuItem Header="_Editor" AutomationProperties.AutomationId="EditorMenu">
                <MenuItem Header="Ir a _sector…" AutomationProperties.AutomationId="GoToSectorMenuItem" Command="local:Commands.GoToSector" InputGestureText="Ctrl+G" />
                <MenuItem Header="Ir a _desplazamiento…" Command="local:Commands.GoToOffset" InputGestureText="Ctrl+Mayús+G" />
                <Separator />
                <MenuItem Header="Sector _anterior" Command="local:Commands.PrevSector" InputGestureText="RePág" />
                <MenuItem Header="Sector s_iguiente" Command="local:Commands.NextSector" InputGestureText="AvPág" />
                <MenuItem Header="_Primer sector" Command="local:Commands.FirstSector" InputGestureText="Ctrl+Inicio" />
                <MenuItem Header="Ú_ltimo sector" Command="local:Commands.LastSector" InputGestureText="Ctrl+Fin" />
                <Separator />
                <MenuItem Header="Ir a cluster / registro…" AutomationProperties.AutomationId="GoToClusterMenuItem" IsEnabled="False" InputGestureText="(M3)" ToolTip="Pendiente: requiere sistemas de archivos (hito M3)" />
            </MenuItem>
            <MenuItem Header="_Modo">
                <MenuItem Header="_Hexadecimal / texto" IsCheckable="True" IsChecked="True" ToolTip="Vista actual del editor" />
                <MenuItem Header="Tabla de _particiones (MBR/GPT)" IsEnabled="False" InputGestureText="(M2)" ToolTip="Pendiente (hito M2)" />
                <MenuItem Header="_Boot sector / superbloque" IsEnabled="False" InputGestureText="(M3)" ToolTip="Pendiente (hito M3)" />
                <MenuItem Header="Plan_tillas de estructuras…" IsEnabled="False" InputGestureText="(M11)" ToolTip="Pendiente (hito M11)" />
            </MenuItem>
            <MenuItem Header="Edi_ción">
                <MenuItem Header="_Copiar volcado hexadecimal" Command="local:Commands.CopyHex" InputGestureText="Ctrl+Mayús+C" />
                <MenuItem Header="Modo _edición" IsEnabled="False" InputGestureText="(M12)" ToolTip="Pendiente: escritura segura (hito M12)" />
            </MenuItem>
            <MenuItem Header="A_yuda">
                <MenuItem Header="_Acerca de MemRescue" Click="About_Click" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <Button Command="Open" Content="Abrir imagen…" ToolTip="Abrir un fichero de imagen de disco en solo lectura (Ctrl+O)" />
                <TextBlock Text="Sector al abrir:" VerticalAlignment="Center" Margin="6,0,4,0" />
                <ComboBox x:Name="SectorSizeBox" Width="90" SelectedIndex="0" AutomationProperties.AutomationId="SectorSizeBox"
                          ToolTip="Tamaño de sector lógico con el que se interpretará la próxima imagen que se abra (Automático: el nativo del contenedor; 512 en RAW)">
                    <ComboBoxItem Content="Automático" />
                    <ComboBoxItem Content="512" />
                    <ComboBoxItem Content="1024" />
                    <ComboBoxItem Content="2048" />
                    <ComboBoxItem Content="4096" />
                </ComboBox>
                <Separator />
                <Button Content="Particiones" AutomationProperties.AutomationId="PartitionsToolbarButton" Click="ShowPartitionsTab_Click"
                        ToolTip="Ver la tabla de particiones del origen seleccionado" />
                <Button Content="Escaneo completo" IsEnabled="False" ToolTip="Pendiente (hito M6)" />
                <Button Content="Recuperar" IsEnabled="False" ToolTip="Pendiente (hito M4)" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="EngineStatusText" Text="Motor: -" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="Solo lectura" Foreground="{StaticResource BrandBrush}" FontWeight="SemiBold" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="PositionText" Text="" FontFamily="Consolas" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Listo" />
            </StatusBarItem>
        </StatusBar>

        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition x:Name="LogSplitterRow" Height="Auto" />
                <RowDefinition x:Name="LogRow" Height="120" MinHeight="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Orígenes abiertos -->
            <DockPanel Grid.Row="0" Grid.Column="0" Background="{StaticResource PanelBrush}">
                <TextBlock DockPanel.Dock="Top" Text="Orígenes abiertos" Style="{StaticResource SectionHeader}" Margin="8,6,8,4" />
                <ListBox x:Name="SourcesList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="SourcesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Row="0" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

            <TabControl x:Name="MainTabs" Grid.Row="0" Grid.Column="2" Margin="4">
                <!-- Visor de sectores -->
                <TabItem x:Name="SectorsTab" Header="Sectores">
                    <DockPanel Margin="6">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button Content="|◀" AutomationProperties.AutomationId="FirstSectorButton" Command="local:Commands.FirstSector" ToolTip="Primer sector (Ctrl+Inicio)" />
                            <Button Content="◀" AutomationProperties.AutomationId="PrevSectorButton" Command="local:Commands.PrevSector" ToolTip="Sector anterior (RePág)" />
                            <TextBlock Text="LBA:" VerticalAlignment="Center" Margin="6,0,4,0" />
                            <TextBox x:Name="LbaBox" Width="140" FontFamily="Consolas" VerticalContentAlignment="Center"
                                     KeyDown="LbaBox_KeyDown" ToolTip="Número de sector (decimal, 0x… o …h). Intro para ir." />
                            <Button Content="Ir" AutomationProperties.AutomationId="GoLbaButton" Click="GoLba_Click" />
                            <Button Content="▶" AutomationProperties.AutomationId="NextSectorButton" Command="local:Commands.NextSector" ToolTip="Sector siguiente (AvPág)" />
                            <Button Content="▶|" AutomationProperties.AutomationId="LastSectorButton" Command="local:Commands.LastSector" ToolTip="Último sector (Ctrl+Fin)" />
                            <TextBlock Text="Sectores por página:" VerticalAlignment="Center" Margin="12,0,4,0" />
                            <ComboBox x:Name="PageSizeBox" Width="50" SelectedIndex="0" SelectionChanged="PageSizeBox_SelectionChanged">
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="4" />
                                <ComboBoxItem Content="8" />
                            </ComboBox>
                        </WrapPanel>
                        <TextBlock x:Name="SectorInfoText" DockPanel.Dock="Top" Margin="0,0,0,4" FontFamily="Consolas"
                                   Foreground="{StaticResource BrandBrush}" />
                        <Border x:Name="TolerantBanner" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,4" Padding="6,3"
                                Background="#FFFFF4E0" BorderBrush="#FFE65100" BorderThickness="1">
                            <TextBlock x:Name="TolerantBannerText" Foreground="#FFBF360C" FontWeight="SemiBold" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="TolerantBannerText" />
                        </Border>
                        <Border x:Name="UntrustedBanner" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,4" Padding="6,3"
                                Background="#FFFCE4E4" BorderBrush="#FFC62828" BorderThickness="1">
                            <TextBlock x:Name="UntrustedBannerText" Foreground="#FFB71C1C" FontWeight="SemiBold" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="UntrustedBannerText" />
                        </Border>
                        <!-- Estado de cada sector de la página (texto + color; también para UI Automation). -->
                        <WrapPanel x:Name="SectorStatesPanel" DockPanel.Dock="Top" Margin="0,0,0,4" />
                        <!-- Leyenda de colores y patrones de relleno en uso. -->
                        <WrapPanel x:Name="StateLegend" DockPanel.Dock="Bottom" Margin="0,4,0,0">
                            <TextBlock Text="Leyenda:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}" />
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NoSourceSectorsText" Text="Abra una imagen de disco (Disco → Abrir imagen…, Ctrl+O) para ver sus sectores."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="4" />
                            <!--
                                Volcado con un bloque coloreado por sector según su estado (ver SectorStatePalette).
                                El color nunca es la única señal: cada bloque conserva su cabecera con el estado y
                                los no fiables, la línea «!! SECTOR NO FIABLE» y una barra lateral gruesa.
                            -->
                            <RichTextBox x:Name="HexView" IsReadOnly="True" IsReadOnlyCaretVisible="True" FontFamily="Consolas" FontSize="13"
                                         AutomationProperties.AutomationId="HexView" BorderThickness="1"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                         PreviewKeyDown="HexView_PreviewKeyDown" Visibility="Collapsed">
                                <FlowDocument PagePadding="2" />
                            </RichTextBox>
                            <ScrollBar x:Name="LbaScrollBar" Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="0"
                                       SmallChange="1" Visibility="Collapsed" Margin="2,0,0,0"
                                       AutomationProperties.AutomationId="LbaScrollBar"
                                       ToolTip="Posición en el origen (arrastre para recorrer imágenes grandes)"
                                       ValueChanged="LbaScrollBar_ValueChanged" />
                        </Grid>
                    </DockPanel>
                </TabItem>

                <!-- Tabla de particiones del origen seleccionado (MBR/EBR; MBR protector o híbrido de GPT). -->
                <TabItem x:Name="PartitionsTab" Header="Particiones">
                    <DockPanel Margin="6">
                        <TextBlock x:Name="PartitionSchemeText" DockPanel.Dock="Top" Margin="0,0,0,4" TextWrapping="Wrap"
                                   Text="Abra una imagen de disco para ver su tabla de particiones."
                                   AutomationProperties.AutomationId="PartitionSchemeText" />
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="OpenPartitionButton" Content="Abrir en el visor" IsEnabled="False"
                                    AutomationProperties.AutomationId="OpenPartitionButton" Click="OpenPartition_Click"
                                    ToolTip="Abre la partición seleccionada como un origen independiente (solo lectura) y muestra su primer sector" />
                            <Button x:Name="RefreshPartitionsButton" Content="Volver a leer" Margin="6,0,0,0"
                                    AutomationProperties.AutomationId="RefreshPartitionsButton" Click="RefreshPartitions_Click"
                                    ToolTip="Vuelve a leer la tabla de particiones del origen seleccionado" />
                        </StackPanel>
                        <TextBlock x:Name="PartitionAnomaliesHeader" DockPanel.Dock="Bottom" Text="Anomalías:" Margin="0,6,0,2"
                                   Foreground="{StaticResource MutedBrush}" />
                        <ListBox x:Name="PartitionAnomaliesList" DockPanel.Dock="Bottom" Height="110"
                                 AutomationProperties.AutomationId="PartitionAnomaliesList"
                                 AutomationProperties.LabeledBy="{Binding ElementName=PartitionAnomaliesHeader}" />
                        <ListView x:Name="PartitionsList" SelectionMode="Single" AutomationProperties.AutomationId="PartitionsList"
                                  SelectionChanged="PartitionsList_SelectionChanged" MouseDoubleClick="PartitionsList_MouseDoubleClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                                    <Setter Property="ToolTip" Value="{Binding Details}" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="N" Width="32" DisplayMemberBinding="{Binding Number}" />
                                    <GridViewColumn Header="Origen" Width="130" DisplayMemberBinding="{Binding Origin}" />
                                    <GridViewColumn Header="Activa" Width="48" DisplayMemberBinding="{Binding ActiveText}" />
                                    <GridViewColumn Header="LBA inicial" Width="90" DisplayMemberBinding="{Binding StartText}" />
                                    <GridViewColumn Header="LBA final" Width="90" DisplayMemberBinding="{Binding EndText}" />
                                    <GridViewColumn Header="Tamaño" Width="80" DisplayMemberBinding="{Binding SizeText}" />
                                    <GridViewColumn Header="Tipo" Width="190" DisplayMemberBinding="{Binding Type}" />
                                    <GridViewColumn Header="Nombre" Width="110" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Confianza" Width="100" DisplayMemberBinding="{Binding ConfidenceText}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Propiedades">
                    <Grid Margin="10">
                        <TextBlock x:Name="NoSourceText" Text="Abra una imagen de disco (Disco → Abrir imagen…, Ctrl+O). Se abre siempre en solo lectura."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <Grid x:Name="PropsGrid" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Ruta" Style="{StaticResource PropName}" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="PropPath" Style="{StaticResource PropValue}" />
                            <TextBlock Grid.Row="1" Text="Formato" Style="{StaticResource PropName}" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="PropFormat" Style="{StaticResource PropValue}" />
                            <TextBlock Grid.Row="2" Text="Tamaño" Style="{StaticResource PropName}" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="PropSize" Style="{StaticResource PropValue}" />
                            <TextBlock Grid.Row="3" Text="Tamaño de sector" Style="{StaticResource PropName}" />
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="PropSector" Style="{StaticResource PropValue}" />
                            <TextBlock Grid.Row="4" Text="Sectores" Style="{StaticResource PropName}" />
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="PropSectors" Style="{StaticResource PropValue}" />
                            <TextBlock Grid.Row="5" Text="Bytes sobrantes" Style="{StaticResource PropName}" />
                            <TextBox Grid.Row="5" Grid.Column="1" x:Name="PropTrailing" Style="{StaticResource PropValue}" />
                            <TextBlock Grid.Row="6" Text="Acceso" Style="{StaticResource PropName}" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="Solo lectura (fichero de imagen)" Style="{StaticResource PropValue}" />
                            <TextBlock Grid.Row="7" Text="Detalles" Style="{StaticResource PropName}" />
                            <TextBox Grid.Row="7" Grid.Column="1" x:Name="PropDetails" Style="{StaticResource PropValue}"
                                     AutomationProperties.AutomationId="PropDetails" />
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ChecksTab" Header="Comprobaciones">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock Text="Hashes del origen" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="Lee el fichero completo en solo lectura. Cualquier error de lectura aborta el cálculo (un hash con datos de relleno no representaría el origen)."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,0,0,8">
                                <CheckBox x:Name="AlgCrc32" Content="CRC-32" Margin="0,0,14,0" />
                                <CheckBox x:Name="AlgMd5" Content="MD5" Margin="0,0,14,0" />
                                <CheckBox x:Name="AlgSha1" Content="SHA-1" Margin="0,0,14,0" />
                                <CheckBox x:Name="AlgSha256" Content="SHA-256" IsChecked="True" Margin="0,0,14,0" />
                            </WrapPanel>
                            <CheckBox x:Name="RecordJob" Margin="0,0,0,8"
                                      Content="Registrar el trabajo en la base de datos de trabajo (SQLite)" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="HashStartButton" Content="Calcular" Click="HashStart_Click" />
                                <Button x:Name="HashCancelButton" Content="Cancelar" Click="HashCancel_Click" IsEnabled="False" />
                            </StackPanel>
                            <ProgressBar x:Name="HashProgress" Height="16" Minimum="0" Maximum="1" />
                            <TextBlock x:Name="HashProgressText" Margin="0,4,0,6" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="HashResults" IsReadOnly="True" FontFamily="Consolas" MinHeight="70" TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Auto" />

                            <TextBlock Text="Comprobación de legibilidad" Style="{StaticResource SectionHeader}" Margin="0,18,0,6" />
                            <TextBlock Text="Lee todos los sectores completos. Si un bloque falla, relee sector a sector con los reintentos indicados. Cada sector queda clasificado como leído, recuperado, ilegible, saltado o disperso; ilegibles y saltados contienen un patrón de relleno, nunca datos."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Reintentos por sector:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="RetriesBox" Width="50" SelectedIndex="1">
                                    <ComboBoxItem Content="0" />
                                    <ComboBoxItem Content="1" />
                                    <ComboBoxItem Content="3" />
                                    <ComboBoxItem Content="10" />
                                </ComboBox>
                                <TextBlock Text="Tras un ilegible, saltar:" VerticalAlignment="Center" Margin="12,0,6,0" />
                                <ComboBox x:Name="JumpBox" Width="70" SelectedIndex="0" AutomationProperties.AutomationId="JumpBox"
                                          ToolTip="Sectores que se marcan como saltados (sin leerlos) tras cada sector ilegible, para no castigar zonas dañadas">
                                    <ComboBoxItem Content="0" />
                                    <ComboBoxItem Content="64" />
                                    <ComboBoxItem Content="256" />
                                    <ComboBoxItem Content="4096" />
                                </ComboBox>
                                <CheckBox x:Name="ReadBackBox" Content="Leer hacia atrás tras el salto" VerticalAlignment="Center" Margin="8,0,0,0"
                                          AutomationProperties.AutomationId="ReadBackBox"
                                          ToolTip="Tras saltar, lee desde el final del salto hacia atrás hasta el siguiente error para recuperar los sectores legibles" />
                                <Button x:Name="VerifyStartButton" Content="Comprobar" Click="VerifyStart_Click" Margin="12,0,4,0" />
                                <Button x:Name="VerifyCancelButton" Content="Cancelar" Click="VerifyCancel_Click" IsEnabled="False" />
                            </StackPanel>
                            <!-- Política de omisión de errores (IO-09) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="IgnoreErrorsBox" Content="Ignorar todos los errores (sin reintentos)" VerticalAlignment="Center"
                                          AutomationProperties.AutomationId="IgnoreErrorsBox"
                                          Checked="IgnoreErrorsBox_Changed" Unchecked="IgnoreErrorsBox_Changed"
                                          ToolTip="Ningún sector se reintenta: al primer fallo queda ilegible (patrón de relleno, nunca datos). Útil en discos muy dañados" />
                                <TextBlock x:Name="SkipCodesLabel" Text="No reintentar los códigos de error:" VerticalAlignment="Center" Margin="16,0,6,0" />
                                <TextBox x:Name="SkipCodesBox" Width="140" VerticalAlignment="Center"
                                         AutomationProperties.AutomationId="SkipCodesBox"
                                         AutomationProperties.LabeledBy="{Binding ElementName=SkipCodesLabel}"
                                         ToolTip="Códigos de error del sistema separados por comas, p. ej. 23 (error de CRC), 1117 (error de E/S del dispositivo). Un sector que falla con uno de ellos queda ilegible sin reintentos" />
                            </StackPanel>
                            <ProgressBar x:Name="VerifyProgress" Height="16" Minimum="0" Maximum="1" />
                            <TextBlock x:Name="VerifyProgressText" Margin="0,4,0,6" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="VerifyResults" IsReadOnly="True" FontFamily="Consolas" MinHeight="70" TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="220" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <GridSplitter x:Name="LogSplitter" Grid.Row="1" Grid.ColumnSpan="3" Height="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" />
            <ListBox x:Name="LogList" Grid.Row="2" Grid.ColumnSpan="3" FontFamily="Consolas" FontSize="11" BorderThickness="0" />
        </Grid>
    </DockPanel>
</Window>
